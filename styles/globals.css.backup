/* 1. Import Tailwind's base, components, and utilities */
@tailwind base;
@tailwind components;
@tailwind utilities;

/* 2. Define the application's theme using CSS variables */
@layer base {
  :root {
    --background: #ffffff; /* White */
    --foreground: #09090b; /* Almost Black */

    --card: #ffffff;
    --card-foreground: #09090b;

    --popover: #ffffff;
    --popover-foreground: #09090b;

    --primary: #27272a; /* Dark Gray */
    --primary-foreground: #fafafa; /* Off-White */

    --secondary: #f4f4f5; /* Light Gray */
    --secondary-foreground: #18181b; /* Dark Gray */

    --muted: #f4f4f5; /* Light Gray */
    --muted-foreground: #71717a; /* Medium Gray */

    --accent: #f4f4f5; /* Light Gray */
    --accent-foreground: #18181b; /* Dark Gray */

    --destructive: #ef4444; /* Red */
    --destructive-foreground: #fafafa; /* Off-White */

    --border: #e4e4e7;
    --input: #e4e4e7;
    --ring: #a1a1aa;

    --radius: 0.5rem;

    /* Enhanced color variables for better visual appeal */
    --gradient-primary: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    --gradient-secondary: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
    --gradient-background: radial-gradient(ellipse at top, #f3f4f6 0%, #ffffff 50%, #f9fafb 100%);
    --gradient-card: linear-gradient(145deg, #ffffff 0%, #f8fafc 100%);
    --shadow-soft: 0 2px 15px -3px rgba(0, 0, 0, 0.07), 0 10px 20px -2px rgba(0, 0, 0, 0.04);
    --shadow-medium: 0 4px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 30px -5px rgba(0, 0, 0, 0.04);
    --shadow-strong: 0 8px 40px -12px rgba(0, 0, 0, 0.2);
  }
}
/* 3. Apply base styles with enhanced background */
@layer base {
  body {
    @apply bg-background text-foreground;
    background: var(--gradient-background);
    min-height: 100vh;
    font-feature-settings: "rlig" 1, "calt" 1;
  }

  /* Enhanced page container with gradient background */
  .min-h-screen {
    background: var(--gradient-background);
    position: relative;
  }

  /* Add a subtle overlay pattern */
  .min-h-screen::before {
    content: '';
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: radial-gradient(circle at 25% 25%, rgba(99, 102, 241, 0.05) 0%, transparent 50%),
                      radial-gradient(circle at 75% 75%, rgba(168, 85, 247, 0.05) 0%, transparent 50%);
    pointer-events: none;
    z-index: -1;
  }
}

/* 4. Enhanced Component Styling */
@layer components {
  /* Enhanced Button Styling */
  .btn-primary {
    @apply inline-flex items-center justify-center rounded-md text-sm font-medium transition-all duration-200;
    @apply bg-primary text-primary-foreground hover:bg-primary/90;
    @apply px-4 py-2 h-10;
    background: var(--gradient-primary);
    box-shadow: var(--shadow-soft);
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  .btn-primary:hover {
    transform: translateY(-1px);
    box-shadow: var(--shadow-medium);
  }

  .btn-secondary {
    @apply inline-flex items-center justify-center rounded-md text-sm font-medium transition-all duration-200;
    @apply bg-secondary text-secondary-foreground hover:bg-secondary/80;
    @apply px-4 py-2 h-10;
    background: var(--gradient-card);
    box-shadow: var(--shadow-soft);
    border: 1px solid var(--border);
  }

  .btn-secondary:hover {
    transform: translateY(-1px);
    box-shadow: var(--shadow-medium);
  }

  /* Enhanced Card Styling */
  .card-enhanced {
    @apply rounded-lg border bg-card text-card-foreground;
    background: var(--gradient-card);
    box-shadow: var(--shadow-soft);
    border: 1px solid rgba(255, 255, 255, 0.3);
    backdrop-filter: blur(10px);
    transition: all 0.3s ease;
  }

  .card-enhanced:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-medium);
  }

  /* Enhanced Input Styling */
  .input-enhanced {
    @apply flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm;
    @apply ring-offset-background file:border-0 file:bg-transparent file:text-sm file:font-medium;
    @apply placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2;
    @apply focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50;
    background: rgba(255, 255, 255, 0.8);
    backdrop-filter: blur(10px);
    transition: all 0.2s ease;
  }

  .input-enhanced:focus {
    background: rgba(255, 255, 255, 0.95);
    box-shadow: var(--shadow-soft);
  }
}
  /* Typography Enhancements */
  .text-enhanced {
    font-feature-settings: "rlig" 1, "calt" 1, "ss01" 1;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  /* Enhanced Headings */
  .heading-primary {
    @apply text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight;
    background: var(--gradient-primary);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    line-height: 1.1;
  }

  .heading-secondary {
    @apply text-2xl md:text-3xl lg:text-4xl font-semibold tracking-tight;
    color: var(--foreground);
    line-height: 1.2;
  }

  .heading-tertiary {
    @apply text-lg md:text-xl lg:text-2xl font-medium tracking-tight;
    color: var(--muted-foreground);
    line-height: 1.3;
  }

  /* Enhanced Text */
  .text-body {
    @apply text-base leading-relaxed;
    color: var(--foreground);
  }

  .text-muted {
    @apply text-sm leading-relaxed;
    color: var(--muted-foreground);
  }

  /* Layout Enhancements */
  .container-enhanced {
    @apply max-w-7xl mx-auto px-4 sm:px-6 lg:px-8;
  }

  .section-enhanced {
    @apply py-16 md:py-24 lg:py-32;
  }

  .grid-enhanced {
    @apply grid gap-6 md:gap-8 lg:gap-12;
  }

  /* Spacing Utilities */
  .space-y-enhanced > * + * {
    margin-top: 1.5rem;
  }

  .space-y-enhanced-lg > * + * {
    margin-top: 2.5rem;
  }
  /* Shadow and Border Effects */
  .shadow-enhanced {
    box-shadow: var(--shadow-soft);
  }

  .shadow-enhanced-medium {
    box-shadow: var(--shadow-medium);
  }

  .shadow-enhanced-strong {
    box-shadow: var(--shadow-strong);
  }

  /* Interactive Elements */
  .interactive-element {
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    cursor: pointer;
  }

  .interactive-element:hover {
    transform: translateY(-1px);
    box-shadow: var(--shadow-medium);
  }

  .interactive-element:active {
    transform: translateY(0);
    box-shadow: var(--shadow-soft);
  }

  /* Glass Morphism Effects */
  .glass-effect {
    background: rgba(255, 255, 255, 0.25);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.18);
    box-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.37);
  }

  /* Gradient Borders */
  .gradient-border {
    position: relative;
    background: var(--gradient-card);
    border-radius: var(--radius);
  }

  .gradient-border::before {
    content: '';
    position: absolute;
    inset: 0;
    padding: 1px;
    background: var(--gradient-primary);
    border-radius: inherit;
    mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    mask-composite: subtract;
  }

  /* Animation Enhancements */
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in-up {
    animation: fadeInUp 0.6s ease-out forwards;
  }

  @keyframes pulse-glow {
    0%, 100% {
      box-shadow: 0 0 5px rgba(99, 102, 241, 0.5);
    }
    50% {
      box-shadow: 0 0 20px rgba(99, 102, 241, 0.8), 0 0 30px rgba(99, 102, 241, 0.6);
    }
  }

  .animate-pulse-glow {
    animation: pulse-glow 2s ease-in-out infinite;
  }
}

/* 5. Utility Classes */
@layer utilities {
  /* Background Utilities */
  .bg-gradient-primary {
    background: var(--gradient-primary);
  }

  .bg-gradient-secondary {
    background: var(--gradient-secondary);
  }

  .bg-gradient-background {
    background: var(--gradient-background);
  }

  .bg-gradient-card {
    background: var(--gradient-card);
  }

  /* Text Utilities */
  .text-gradient-primary {
    background: var(--gradient-primary);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  /* Backdrop Blur */
  .backdrop-blur-enhanced {
    backdrop-filter: blur(12px);
  }
}